# Contact form delivery — set these in the host's env (Vercel project settings).
# Never prefix with PUBLIC_ and never commit real values.

# Where contact messages are delivered (destination stays server-side only).
CONTACT_TO=you@example.com

# Resend transport: https://resend.com — verify rakeemchapman.com there first.
RESEND_API_KEY=
# Optional verified sender; defaults to contact@rakeemchapman.com.
CONTACT_FROM=

# Alternative transport: POSTs {subject,name,email,message,at} as JSON
# to this URL instead of Resend (CRM inbound hook, automation tool, etc).
CONTACT_WEBHOOK_URL=

# Turnstile bot protection (free, no tracking; dash.cloudflare.com → Turnstile).
# Set BOTH together. Site key is public by design — it ships to the browser.
PUBLIC_TURNSTILE_SITE_KEY=
# Secret is server-only. When set, every submission must carry a valid token;
# the endpoint rejects anything without one (fails closed).
TURNSTILE_SECRET_KEY=
