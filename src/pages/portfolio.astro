---
import Base from '../layouts/Base.astro';

const projects = [
  {
    type: 'Platform · Evaluation',
    title: 'Open World Bench',
    period: '2026',
    desc: 'A benchmark platform I built to test coding agents on bugs and changes pulled from production software, using deterministic grading checks inside isolated runners that fail closed until isolation is verified.',
    points: [
      'Ten-task calibration suite drawn from real software incidents, with versioned task definitions and environment manifests.',
      'Fixed objective and guardrail checks with seeded bootstrap confidence intervals and mergeability gates.',
      'Held-out grading checks stay unpublished to prevent contamination; dashboard scores are labeled synthetic demo data.',
    ],
    stack: 'Next.js · TypeScript · zod · bootstrap statistics · isolated-runner contract',
    img: '/images/owb.webp',
    alt: 'Open World Bench dashboard showing a synthetic leaderboard and engineering index scores',
    link: null,
    note: 'Public alpha. Dashboard results are synthetic; no model claims yet.',
  },
  {
    type: 'Game · Strategy',
    title: 'Aurelia: Empires of the Sun',
    period: '2026',
    desc: 'A Roman real-time strategy game that runs in the browser, with AI opponents, resource gathering, construction, save/load, and tech progression across four ages.',
    points: [
      'Built by directing AI coding agents through a strict verification loop where changes required passing tests and screenshots.',
      'Automated browser tests check game loops across Chromium, Firefox, and WebKit.',
      'Pixel-level checks verify that 3D units render visibly, stand upright on terrain, and animate.',
    ],
    stack: 'Unity · WebGL · C# · AI agents · browser test harness',
    img: '/images/aurelia.webp',
    alt: 'New Kingdom: Empires of the Sun start screen, with scenario settings and a Begin conquest button',
    link: { href: 'https://new-kingdom-empires.vercel.app/', label: 'Play Now →' },
    note: 'The public build is an earlier version of the game.',
  },
  {
    type: 'App · Meetings',
    title: 'Open Meet',
    period: '2026',
    desc: 'A self-hosted video meeting application built around Jitsi, with shareable invitation links, optional passcodes, waiting-room controls, and host-private notes.',
    points: [
      'Separate participant and private host links with room access gated by signed tokens.',
      'Host workspace for private notes alongside optional call transcription, summaries, and follow-up action items.',
      'Meeting privacy, media, and optional summary features depend on the configured self-hosted services.',
],
    stack: 'Jitsi · Node.js · JWT room auth · self-hosted infrastructure',
    img: '/images/open-meet.jpg',
    alt: 'Open Meet home page with meeting controls and deployment information',
    link: { href: 'https://open-meet-rakeem.vercel.app/', label: 'Use →' },
    note: 'Live deployment. Meeting media and optional features depend on configured services.',
  },
  {
    type: 'App · Learning',
    title: 'Python Play',
    period: '2026',
    desc: 'A browser-based course I built to teach Python, pandas, SQL, and introductory data engineering through 46 interactive missions.',
    points: [
      '138 graded problems across 13 chapters and four capstones, running locally in Web Workers via Pyodide and SQLite WASM without a server or login.',
      'Covers syntax, files, joins, window functions, warehouse grain, date-stamped snapshots, idempotent backfills, and metric QA.',
      'Includes Guided, Stretch, and Independent modes, with streaks, drafts, and notes saved in local browser storage.',
    ],
    stack: 'Pyodide · SQLite WASM · Web Workers · vanilla JS · local-first',
    img: '/images/python-play.webp',
    alt: 'Python Play mission page with instruction panel, code editor and output console',
    link: { href: 'https://pythonplay.vercel.app/', label: 'Try it →' },
    note: null,
  },
];
---
<Base title="Portfolio" description="Benchmarks, applications, and browser projects built by Rakeem Chapman to test agent evaluation, verification loops, and local-first software.">
  <section class="wrap head">
    <p class="label kicker">Portfolio</p>
    <h1>Projects and testbeds.</h1>
    <p class="lede">Benchmarks, applications, and browser builds I’ve put together to test coding-agent evaluation, automated verification loops, and local-first software.</p>
  </section>
  <section class="wrap list">
    {projects.map((p) => (
      <article class="proj">
        <div class="side">
          <p class="label accent">{p.type}</p>
          <p class="period">{p.period}</p>
        </div>
        <div class="main">
          {p.img && <img class="shot" src={p.img} alt={p.alt} width="720" height="405" loading="lazy" />}
          <h2>{p.title}</h2>
          <p class="desc">{p.desc}</p>
          <ul>
            {p.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <p class="stack label">{p.stack}</p>
          {p.link && <a class="btn" href={p.link.href}>{p.link.label}</a>}
          {p.note && <p class="note">{p.note}</p>}
        </div>
      </article>
    ))}
  </section>
</Base>
<style>
  .kicker { color: var(--accent); margin-bottom: 14px; }
  .head { padding: 72px 0 40px; }
  .head h1 { margin: 0 0 20px; }
  .list { padding-bottom: 96px; }
  .proj { display: grid; grid-template-columns: 200px 1fr; gap: 48px; padding: 44px 0; border-top: 1px solid var(--ink); }
  .side { padding-top: 6px; }
  .period { font: .85rem var(--mono); color: var(--ink-3); margin: 8px 0 0; }
  .shot { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--ink); box-shadow: 10px 10px 0 var(--accent); margin-bottom: 26px; }
  .shot[src="/images/open-meet.jpg"] { object-position: left center; }
  .main h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .desc { color: var(--ink-2); max-width: 40em; }
  ul { margin: 16px 0 20px; padding-left: 1.1em; }
  li { color: var(--ink-2); margin-bottom: .45em; }
  li::marker { color: var(--accent); }
  .stack { margin-bottom: 20px; }
  .note { font: .78rem var(--mono); color: var(--ink-3); margin-top: 12px; }
  @media (max-width: 820px) {
    .proj { grid-template-columns: 1fr; gap: 10px; padding: 36px 0; }
    .side { padding-top: 0; display: flex; gap: 16px; align-items: baseline; }
    .period { margin: 0; }
  }
</style>
