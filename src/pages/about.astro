---
import Base from '../layouts/Base.astro';

const beliefs = [
  { h: 'How work is structured and checked drives the result.', p: 'Two teams using the same model get different results depending on how tasks are broken down, wired into daily tools, and checked before anyone acts on them. Those are choices a team can change and measure.' },
  { h: 'Gains in the middle add up.', p: 'A steady improvement across a whole operating team adds more total output than a large gain for one power user.' },
  { h: 'Most of what works can be built into software.', p: 'Effective AI use comes down to clear inputs, bounded steps, and explicit checks. Once that process is clear, it can be taught to a team or built directly into the software they already use.' },
  { h: 'Models draft. Systems decide.', p: 'Models are useful for reading messy input, drafting replies, and summarizing context. Routing, pricing, permissions, bookings, and records should run through rules you can inspect and test.' },
];

const principles = [
  { h: 'Evidence first', p: 'A claim isn’t done until there’s something concrete to check: a passing test, a recorded trace, or a measured number.' },
  { h: 'Every angle', p: 'If an explanation only holds up from one direction, it’s probably a symptom rather than the root cause.' },
  { h: 'Bend the median', p: 'I judge a tool by what a typical operator gets from it during a normal workday, not by the best demo.' },
  { h: 'Plain language', p: 'If I can’t explain how a system works or why it failed in plain terms, I don’t understand it well enough yet.' },
];
---
<Base title="About" description="Rakeem Chapman works on bending the median of AI: evaluating frontier models and agents, structuring robotics data, and building AI software for operating businesses.">
  <section class="wrap intro">
    <div>
      <p class="label kicker">About</p>
      <h1>I build and test systems that bend the median of&nbsp;AI.</h1>
      <p class="lede">I split my time between frontier evaluation and software for operating businesses. On the frontier side, I grade models and coding agents on multi-step engineering tasks, build isolated evaluation harnesses, and turn raw robotics captures into structured training data. On the operating side, I build voice, text, and back-office software for service businesses, starting with speed-to-lead, job qualification, booking, and follow-up. Working in both settings shows what models can handle reliably on their own and where software rules and human review still have to carry the weight.</p>
      <div class="ctas">
        <a class="btn" href="/#contact">Get in touch</a>
        <a class="btn line" href="/blog">Read the blog</a>
      </div>
    </div>
    <figure class="photo"><img src="/images/portrait.webp" alt="Portrait of Rakeem Chapman" width="640" height="801" /></figure>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="label kicker">What I believe</p>
      <h2>Four ideas behind the work.</h2>
      <ol class="beliefs">
        {beliefs.map((b, i) => (<li><span class="label accent">0{i + 1}</span><div><h3>{b.h}</h3><p>{b.p}</p></div></li>))}
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-grid">
      <figure><img src="/images/mural.webp" alt="Rakeem Chapman" width="1100" height="825" loading="lazy" /></figure>
      <div>
        <p class="label kicker">How I decide</p>
        <h2>Principles I work by.</h2>
        <ul class="principles">
          {principles.map((p) => (<li><h3>{p.h}</h3><p>{p.p}</p></li>))}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap cta">
    <h2>Working on something similar?</h2>
    <p class="lede">If you run an operating business, evaluate models and agents, or build software that puts AI into daily work, I’d like to compare notes.</p>
    <div class="ctas">
      <a class="btn" href="/#contact">Get in touch →</a>
    </div>
  </section>
</Base>
<style>
  .kicker { color: var(--accent); margin-bottom: 14px; }
  .intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center; padding: 64px 0 88px; }
  .intro h1 { font-size: clamp(2.4rem, 4.8vw, 4rem); margin: 0 0 26px; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 30px; }
  .photo { margin: 0; }
  .photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--ink); box-shadow: 12px 12px 0 var(--accent); }
  .beliefs { list-style: none; margin: 28px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .beliefs li { display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 26px 0; border-bottom: 1px solid var(--rule); }
  .beliefs .label { padding-top: .5em; }
  .beliefs h3 { font-size: 1.55rem; margin-bottom: 8px; }
  .beliefs p { margin: 0; color: var(--ink-2); max-width: 44em; }
  .band { background: var(--ink); color: var(--paper); padding: 96px 0; }
  .band-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: center; }
  .band figure { margin: 0; }
  .band img { width: 100%; height: auto; border: 1px solid #3a3935; box-shadow: -14px 14px 0 var(--accent); }
  .band .kicker { color: #8fa0ff; }
  .principles { list-style: none; margin: 24px 0 0; padding: 0; }
  .principles li { padding: 14px 0; border-top: 1px solid #3a3935; }
  .principles h3 { margin: 0 0 4px; font-size: 1.2rem; }
  .principles p { margin: 0; color: #c4c1b8; font-size: .95rem; }
  .cta { padding: 96px 0 104px; text-align: center; }
  .cta .lede { margin-inline: auto; }
  .cta .ctas { justify-content: center; }
  @media (max-width: 900px) {
    .intro, .band-grid { grid-template-columns: 1fr; gap: 40px; }
    .intro { padding-top: 36px; }
    .photo { max-width: 360px; }
    .band { padding: 72px 0; }
  }
  @media (max-width: 560px) { .beliefs li { grid-template-columns: 1fr; gap: 6px; } }
</style>
