---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingMinutes, type Post } from '../../lib/posts';
import { SERIES } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
interface Props { post: Post; newer?: Post; older?: Post; }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article class="wrap post">
    <header>
      <p class="label meta">
        <a href="/blog">← Blog</a>
        <span>{SERIES[post.data.series].label}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingMinutes(post)} min read</span>
        {post.data.draft && <span class="tag draft">Draft</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
    <footer class="end">
      <div class="author">
        <img src="/images/hero.webp" alt="" width="64" height="64" loading="lazy" />
        <p><strong>Rakeem Chapman</strong> writes about bending the median of AI. Disagree, or see a better root cause? <a href="/#contact">Reply via the contact form</a>. I read everything.</p>
      </div>
      <nav class="pager" aria-label="More posts">
        {older ? <a href={`/blog/${older.id}`}><span class="label">← Older</span>{older.data.title}</a> : <span />}
        {newer && <a class="newer" href={`/blog/${newer.id}`}><span class="label">Newer →</span>{newer.data.title}</a>}
      </nav>
    </footer>
  </article>
</Base>
<style>
  .post { padding: 64px 0 80px; }
  header { max-width: 860px; margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--ink); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin-bottom: 28px; }
  .meta a { text-decoration: none; color: var(--accent); }
  h1 { font-size: clamp(2.3rem, 5vw, 4rem); }
  .prose { margin-left: calc(var(--gutter) + 32px); }
  .end { margin: 64px 0 0 calc(var(--gutter) + 32px); max-width: var(--measure); border-top: 1px solid var(--rule); padding-top: 24px; }
  .author { display: flex; gap: 16px; align-items: center; }
  .author img { width: 64px; height: 64px; flex: none; border-radius: 50%; object-fit: cover; object-position: 50% 25%; border: 1px solid var(--ink); }
  .author p { margin: 0; font: 1.05rem/1.5 var(--serif); color: var(--ink-2); }
  .author strong { color: var(--ink); font-weight: 600; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
  .pager a { display: grid; gap: 6px; padding: 16px; border: 1px solid var(--ink); text-decoration: none; font: 1.05rem/1.3 var(--serif); }
  .pager a:hover { background: var(--ink); color: var(--paper); }
  .pager .newer { text-align: right; grid-column: 2; }
  @media (max-width: 860px) { .prose, .end { margin-left: 0; } }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .newer { grid-column: auto; text-align: left; } }
</style>
