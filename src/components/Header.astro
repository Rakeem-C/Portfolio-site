---
import Mark from './Mark.astro';
import { NAV, SITE } from '../site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentPage = (href: string) => href.startsWith('/') && !href.includes('#')
  && (path === href || path.startsWith(href + '/')) ? 'page' : undefined;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <Mark />
      <span>Rakeem Chapman</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={currentPage(n.href)}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="hello" href="/#contact">Let’s talk</a>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Primary">
        <ul>
          {NAV.map((n) => <li><a href={n.href} aria-current={currentPage(n.href)}>{n.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--paper) 90%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 600 1rem/1 var(--sans); letter-spacing: -0.01em; margin-right: auto; }
  ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 8px 10px; font: 500 .78rem/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; color: var(--ink-2); }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }
  .hello { font: 600 .85rem/1 var(--sans); text-decoration: none; padding: 10px 14px; border: 1.5px solid var(--ink); }
  .hello:hover { background: var(--ink); color: var(--paper); }
  .mobile-menu { display: none; }
  @media (max-width: 720px) {
    .bar { gap: 8px; position: relative; }
    .brand { gap: 6px; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    summary { cursor: pointer; padding: 10px 5px; font-size: .85rem; }
    .mobile-menu nav { position: absolute; inset: 100% 0 auto; background: var(--paper); border: 1px solid var(--rule); }
    .mobile-menu ul { display: block; }
    .mobile-menu nav a { padding: 14px; }
    .hello { padding: 8px; font-size: .8rem; white-space: nowrap; }
  }
</style>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
