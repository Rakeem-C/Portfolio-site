---
interface Props { size?: number; }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <path d="M3 28.5 H29" stroke="currentColor" stroke-width="1.2" />
  <path class="mark-curve" d="M3 27 C 14 26.5, 21 23, 26 5" fill="none" stroke="currentColor" stroke-width="1.8" />
  <circle class="mark-dot" cx="15.5" cy="25.2" r="3.2" fill="var(--accent)" />
</svg>
<style>
@media (prefers-reduced-motion: no-preference) {
.mark-curve { animation: mark-bend 5.6s ease-in-out infinite; }
.mark-dot { animation: mark-dot-rise 5.6s ease-in-out infinite; }
}
@keyframes mark-bend {
  0%, 100% { d: path("M 3 27 C 14 26.5, 21 23, 26 5"); }
  50% { d: path("M 3 23.5 C 9.5 10, 18.5 8.2, 26 7.4"); }
}
@keyframes mark-dot-rise {
  0%, 100% { transform: translate(0px, 0px); }
  50% { transform: translate(-0.5px, -14.7px); }
}
</style>
